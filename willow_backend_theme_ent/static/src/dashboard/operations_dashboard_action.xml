<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <t t-name="willow_backend_theme_ent.OperationsDashboardAction">
    <div class="o_action o_willow_dashboard_action wl_sp_action_shell">
      <div class="wl_erp_theme_page tt_dashboard_page">
        <!-- Inline SVG hero inherits theme hero CSS variables. Prefixed IDs avoid clashes with shell mounts. -->
        <div class="wl_erp_hero_art" aria-hidden="true" data-wl-hero-art="wl-hero-home-">
          <svg class="wl_erp_hero_art_svg" viewBox="0 0 2048 684" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
            <defs>
              <linearGradient id="wl-hero-home-base" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="var(--hero-surface-start)"/>
                <stop offset=".52" stop-color="var(--hero-surface-mid)"/>
                <stop offset="1" stop-color="var(--hero-surface-end)"/>
              </linearGradient>
              <linearGradient id="wl-hero-home-left-ribbon" x1=".1" y1=".1" x2=".9" y2=".9">
                <stop offset="0" stop-color="var(--hero-accent-strong)" stop-opacity=".55"/>
                <stop offset=".48" stop-color="var(--hero-accent)" stop-opacity=".34"/>
                <stop offset="1" stop-color="var(--hero-accent-soft)" stop-opacity=".16"/>
              </linearGradient>
              <linearGradient id="wl-hero-home-center-ribbon" x1=".05" y1=".05" x2=".9" y2=".95">
                <stop offset="0" stop-color="var(--hero-accent)" stop-opacity=".22"/>
                <stop offset=".52" stop-color="var(--hero-accent-soft)" stop-opacity=".14"/>
                <stop offset="1" stop-color="var(--hero-highlight)" stop-opacity=".4"/>
              </linearGradient>
              <radialGradient id="wl-hero-home-left-glow" cx=".04" cy=".86" r=".8">
                <stop offset="0" stop-color="var(--hero-accent-strong)" stop-opacity=".36"/>
                <stop offset=".6" stop-color="var(--hero-accent)" stop-opacity=".1"/>
                <stop offset="1" stop-color="var(--hero-accent)" stop-opacity="0"/>
              </radialGradient>
              <radialGradient id="wl-hero-home-center-glow" cx=".56" cy=".52" r=".7">
                <stop offset="0" stop-color="var(--hero-highlight)" stop-opacity=".7"/>
                <stop offset="1" stop-color="var(--hero-highlight)" stop-opacity="0"/>
              </radialGradient>
              <filter id="wl-hero-home-soften" x="-20%" y="-20%" width="140%" height="140%">
                <feGaussianBlur stdDeviation="34"/>
              </filter>
            </defs>
            <rect width="2048" height="684" fill="url(#wl-hero-home-base)"/>
            <rect width="2048" height="684" fill="url(#wl-hero-home-left-glow)"/>
            <path d="M 206 -28 C 80 128, 3 318, -22 494 L -22 584 C 38 330, 207 129, 505 -28 Z" fill="url(#wl-hero-home-left-ribbon)"/>
            <path d="M 982 -28 C 699 186, 565 430, 617 720 L 1410 720 C 1370 468, 1417 221, 1542 -28 Z" fill="url(#wl-hero-home-center-ribbon)"/>
            <ellipse cx="1090" cy="348" rx="455" ry="310" fill="url(#wl-hero-home-center-glow)" filter="url(#wl-hero-home-soften)"/>
            <ellipse cx="1900" cy="330" rx="400" ry="340" fill="url(#wl-hero-home-center-glow)" opacity=".58" filter="url(#wl-hero-home-soften)"/>
            <g fill="none" stroke="var(--hero-seam)" stroke-width="5" stroke-linecap="round" opacity="var(--hero-seam-opacity)">
              <path d="M 206 -28 C 80 128, 3 318, -22 494"/>
              <path d="M 505 -28 C 207 129, 38 330, -22 584"/>
              <path d="M 982 -28 C 699 186, 565 430, 617 720"/>
              <path d="M 1542 -28 C 1417 221, 1370 468, 1410 720"/>
            </g>
          </svg>
        </div>

        <!-- A · Header -->
        <section class="wl_erp_dashboard_header tt_dashboard_header">
          <div class="wl_erp_dashboard_header_main">
            <h2 class="wl_erp_dashboard_title">Hi, <t t-esc="state.header.userName"/></h2>
            <p class="wl_erp_dashboard_subtitle">Your open work at a glance</p>
          </div>
          <div class="wl_erp_dashboard_header_actions tt_dashboard_intro_actions">
            <button
              t-if="state.spreadsheetDashboardAvailable"
              class="tt_dashboard_button tt_dashboard_button_primary"
              type="button"
              t-on-click="openSpreadsheetDashboard"
            >
              Spreadsheet Dashboard
            </button>
          </div>
        </section>

        <main class="wl_erp_dashboard_content tt_dashboard_content">
          <div class="tt_dashboard_shell" t-att-class="{ 'is-loading': state.loading, 'is-error': state.error }">

            <div class="tt_dashboard_error_banner" t-if="state.error" role="alert">
              <p t-esc="state.summary.text"/>
              <button type="button" class="tt_dashboard_button tt_dashboard_button_primary" t-on-click="() => this.loadDashboard()">
                Retry
              </button>
            </div>

            <!-- B · KPI (top of homepage) -->
            <section class="tt_dashboard_stats" t-if="state.summaryCards.length">
              <article
                t-foreach="state.summaryCards"
                t-as="card"
                t-key="card.key"
                class="tt_dashboard_stat"
                t-att-class="`tt_dashboard_stat_${card.tone}${card.clickable ? ' is-clickable' : ''}${card.urgent ? ' is-urgent' : ''}`"
                t-on-click="() => this.openSummaryCard(card)"
              >
                <div class="tt_dashboard_stat_top">
                  <span class="tt_dashboard_stat_label" t-esc="card.label"/>
                  <span class="tt_dashboard_stat_icon" aria-hidden="true">
                    <i t-att-class="'fa ' + card.icon"/>
                  </span>
                </div>
                <strong class="tt_dashboard_stat_value" t-esc="card.value"/>
                <p class="tt_dashboard_stat_meta" t-esc="card.meta"/>
                <div class="tt_dashboard_stat_share" t-att-aria-hidden="true">
                  <span class="tt_dashboard_stat_share_fill" t-att-style="'width:' + card.sharePct + '%'"/>
                </div>
                <p class="tt_dashboard_stat_secondary" t-if="card.secondary" t-esc="card.secondary"/>
              </article>
            </section>

            <!-- BIZ · Business Dashboard (ERP mockup grid) -->
            <div class="wl_erp_biz_dashboard" t-if="state.businessDashboard" aria-label="Business overview">
              <div class="wl_erp_dashboard_grid">

                <!-- Receivables -->
                <article
                  class="wl_erp_card wl_erp_metric_card"
                  t-if="state.businessDashboard.receivables"
                  tabindex="0"
                  t-on-click="() => this.openReceivables('view_invoices')"
                  t-on-keydown="(ev) => ev.key === 'Enter' &amp;&amp; this.openReceivables('view_invoices')"
                >
                  <div class="wl_erp_metric_header">
                    <div class="wl_erp_metric_header_start">
                      <span class="wl_erp_small_icon_box purple" aria-hidden="true"><i class="fa fa-file-text-o"/></span>
                      <h3 class="wl_erp_metric_title">Total Receivables</h3>
                    </div>
                  </div>
                  <p class="wl_erp_metric_value" t-esc="state.businessDashboard.receivables.amount"/>
                  <p class="wl_erp_metric_change">
                    <span t-esc="state.businessDashboard.receivables.count"/> unpaid
                    <t t-if="state.businessDashboard.receivables.count === 1"> document</t>
                    <t t-else=""> documents</t>
                  </p>
                  <div class="wl_erp_metric_actions">
                    <button type="button" class="wl_erp_action_button" t-if="state.businessDashboard.receivables.actions.receive_payment" t-on-click.stop="() => this.openReceivables('receive_payment')">
                      <i class="fa fa-plus" aria-hidden="true"/> Receive Payment
                    </button>
                    <button type="button" class="wl_erp_action_button is-ghost" t-if="state.businessDashboard.receivables.actions.view_invoices" t-on-click.stop="() => this.openReceivables('view_invoices')">
                      <i class="fa fa-list" aria-hidden="true"/> View Invoices
                    </button>
                  </div>
                </article>

                <!-- Payables -->
                <article
                  class="wl_erp_card wl_erp_metric_card"
                  t-if="state.businessDashboard.payables"
                  tabindex="0"
                  t-on-click="() => this.openPayables('view_bills')"
                  t-on-keydown="(ev) => ev.key === 'Enter' &amp;&amp; this.openPayables('view_bills')"
                >
                  <div class="wl_erp_metric_header">
                    <div class="wl_erp_metric_header_start">
                      <span class="wl_erp_small_icon_box rose" aria-hidden="true"><i class="fa fa-file-text"/></span>
                      <h3 class="wl_erp_metric_title">Total Payables</h3>
                    </div>
                  </div>
                  <p class="wl_erp_metric_value" t-esc="state.businessDashboard.payables.amount"/>
                  <p class="wl_erp_metric_change">
                    <span t-esc="state.businessDashboard.payables.count"/> unpaid
                    <t t-if="state.businessDashboard.payables.count === 1"> bill</t>
                    <t t-else=""> bills</t>
                  </p>
                  <div class="wl_erp_metric_actions is-compact">
                    <button type="button" class="wl_erp_action_button" t-if="state.businessDashboard.payables.actions.pay_bills" t-on-click.stop="() => this.openPayables('pay_bills')">
                      <i class="fa fa-money" aria-hidden="true"/> Pay Bills
                    </button>
                    <button type="button" class="wl_erp_action_button is-ghost" t-if="state.businessDashboard.payables.actions.vendor_invoices" t-on-click.stop="() => this.openPayables('vendor_invoices')">
                      <i class="fa fa-list" aria-hidden="true"/> Vendor Invoices
                    </button>
                  </div>
                </article>

                <!-- Sales (spans 2 rows) -->
                <article
                  class="wl_erp_card wl_erp_wide_card wl_erp_sales_summary_card"
                  t-if="state.businessDashboard.sales"
                  tabindex="0"
                  t-on-click="() => this.openBizAction(state.businessDashboard.sales.actionXmlid)"
                  t-on-keydown="(ev) => ev.key === 'Enter' &amp;&amp; this.openBizAction(state.businessDashboard.sales.actionXmlid)"
                >
                  <div class="wl_erp_sales_top">
                    <div class="wl_erp_metric_header_start">
                      <span class="wl_erp_small_icon_box blue" aria-hidden="true"><i class="fa fa-shopping-cart"/></span>
                      <h3 class="wl_erp_metric_title">Total Sales (This Month)</h3>
                    </div>
                  </div>
                  <div class="wl_erp_sales_value_row">
                    <span class="wl_erp_sales_value" t-esc="state.businessDashboard.sales.amount"/>
                    <span class="wl_erp_target_text" t-if="state.businessDashboard.sales.progress">
                      of <t t-esc="state.businessDashboard.sales.progress.targetLabel"/> target
                    </span>
                  </div>
                  <div class="wl_erp_progress_track" t-if="state.businessDashboard.sales.progress" role="progressbar"
                    t-att-aria-valuenow="state.businessDashboard.sales.progress.pct" aria-valuemin="0" aria-valuemax="100">
                    <div class="wl_erp_progress_fill" t-att-style="salesProgressStyle()"/>
                  </div>
                  <div class="wl_erp_sales_stats" t-if="state.businessDashboard.sales.orders or state.businessDashboard.sales.conversionRate">
                    <div class="wl_erp_sales_stat" t-if="state.businessDashboard.sales.orders">
                      <div class="wl_erp_sales_stat_label">Orders</div>
                      <div class="wl_erp_sales_stat_value" t-esc="state.businessDashboard.sales.orders.count"/>
                    </div>
                    <div class="wl_erp_sales_stat" t-if="state.businessDashboard.sales.avgOrderValue">
                      <div class="wl_erp_sales_stat_label">Avg. Order Value</div>
                      <div class="wl_erp_sales_stat_value" t-esc="state.businessDashboard.sales.avgOrderValue.amount"/>
                    </div>
                    <div class="wl_erp_sales_stat" t-if="state.businessDashboard.sales.conversionRate">
                      <div class="wl_erp_sales_stat_label">Conversion Rate</div>
                      <div class="wl_erp_sales_stat_value"><t t-esc="state.businessDashboard.sales.conversionRate.rate"/>%</div>
                    </div>
                  </div>
                </article>

                <!-- Cash in Hand -->
                <article class="wl_erp_card wl_erp_metric_card" t-if="state.businessDashboard.cash">
                  <div class="wl_erp_metric_header">
                    <div class="wl_erp_metric_header_start">
                      <span class="wl_erp_small_icon_box" aria-hidden="true"><i class="fa fa-bank"/></span>
                      <h3 class="wl_erp_metric_title">Cash in Hand</h3>
                    </div>
                  </div>
                  <p class="wl_erp_metric_value" t-esc="state.businessDashboard.cash.amount"/>
                </article>

                <!-- Open Purchase Orders -->
                <article
                  class="wl_erp_card wl_erp_metric_card"
                  t-if="state.businessDashboard.openPurchaseOrders"
                  tabindex="0"
                  t-on-click="openBizPurchaseOrders"
                  t-on-keydown="(ev) => ev.key === 'Enter' &amp;&amp; this.openBizPurchaseOrders()"
                >
                  <div class="wl_erp_metric_header">
                    <div class="wl_erp_metric_header_start">
                      <span class="wl_erp_small_icon_box purple" aria-hidden="true"><i class="fa fa-shopping-basket"/></span>
                      <h3 class="wl_erp_metric_title">Open Purchase Orders</h3>
                    </div>
                  </div>
                  <p class="wl_erp_open_po_count" t-esc="state.businessDashboard.openPurchaseOrders.count"/>
                  <p class="wl_erp_metric_change">
                    value <strong t-esc="state.businessDashboard.openPurchaseOrders.amount"/>
                  </p>
                </article>

                <!-- Top Inventory -->
                <article class="wl_erp_card wl_erp_inventory_card" t-if="state.businessDashboard.topInventoryAvailable">
                  <h3 class="wl_erp_section_title">Top Items in Inventory</h3>
                  <t t-if="state.businessDashboard.topInventoryItems.length">
                    <div class="wl_erp_inventory_list">
                      <div
                        t-foreach="state.businessDashboard.topInventoryItems"
                        t-as="item"
                        t-key="item.productId"
                        class="wl_erp_inventory_item"
                        tabindex="0"
                        t-on-click="() => this.openInventoryItem(item)"
                        t-on-keydown="(ev) => ev.key === 'Enter' &amp;&amp; this.openInventoryItem(item)"
                      >
                        <span class="wl_erp_product_image" aria-hidden="true">
                          <img t-if="item.imageUrl" t-att-src="item.imageUrl" t-att-alt="item.name" class="wl_erp_inv_img"/>
                          <i t-else="" class="fa fa-cube"/>
                        </span>
                        <div>
                          <div class="wl_erp_product_name" t-esc="item.name"/>
                          <div class="wl_erp_product_sku" t-if="item.defaultCode">SKU: <t t-esc="item.defaultCode"/></div>
                        </div>
                        <div class="wl_erp_stock_value">
                          <t t-esc="inventoryUnitsLabel(item)"/>
                        </div>
                      </div>
                    </div>
                  </t>
                  <t t-else="">
                    <div class="tt_dashboard_empty_state tt_dashboard_empty_state_compact">
                      <h4>No stock on hand</h4>
                      <p>Internal inventory quantities will appear here.</p>
                    </div>
                  </t>
                </article>

                <!-- Recent Transactions -->
                <article class="wl_erp_card wl_erp_transactions_card" t-if="state.businessDashboard.recentTransactionsAvailable">
                  <div class="wl_erp_card_header_row">
                    <h3 class="wl_erp_section_title">Recent Transactions</h3>
                  </div>
                  <t t-if="state.businessDashboard.recentTransactions.length">
                    <table class="wl_erp_transactions_table" role="table">
                      <thead>
                        <tr>
                          <th scope="col">Document No.</th>
                          <th scope="col">Type</th>
                          <th scope="col">Date</th>
                          <th scope="col">Party</th>
                          <th scope="col">Amount</th>
                          <th scope="col">Status</th>
                        </tr>
                      </thead>
                      <tbody>
                        <tr
                          t-foreach="state.businessDashboard.recentTransactions"
                          t-as="row"
                          t-key="row.model + '-' + row.resId"
                          tabindex="0"
                          t-on-click="() => this.openTransactionRow(row)"
                          t-on-keydown="(ev) => ev.key === 'Enter' &amp;&amp; this.openTransactionRow(row)"
                        >
                          <td>
                            <div class="wl_erp_doc_cell">
                              <span class="wl_erp_doc_icon" t-att-class="txnDocIconClass(row.typeKey)" aria-hidden="true"><i class="fa fa-file-text-o"/></span>
                              <span t-esc="row.docNumber"/>
                            </div>
                          </td>
                          <td t-esc="row.type"/>
                          <td t-esc="formatBizDate(row.date)"/>
                          <td t-esc="row.party"/>
                          <td><strong t-esc="row.amount"/></td>
                          <td>
                            <span class="wl_erp_status_pill" t-att-class="txnStatusClass(row.statusKey)" t-esc="row.status"/>
                          </td>
                        </tr>
                      </tbody>
                    </table>
                  </t>
                  <t t-else="">
                    <div class="tt_dashboard_empty_state tt_dashboard_empty_state_compact">
                      <h4>No recent transactions</h4>
                      <p>Invoices, orders, and bills will show up here.</p>
                    </div>
                  </t>
                </article>

              </div>
            </div>

            <!-- C · Charts 7/5 -->
            <section class="tt_dashboard_row tt_dashboard_row_charts">
              <div class="tt_dashboard_panel tt_dashboard_panel_chart">
                <div class="tt_dashboard_panel_head">
                  <div>
                    <h3 t-esc="state.activityChart.chartTitle"/>
                    <p t-esc="state.activityChart.subtitle"/>
                  </div>
                  <button type="button" class="tt_dashboard_panel_select" t-on-click="toggleChartPeriod" t-esc="state.activityChart.periodLabel"/>
                </div>
                <div class="tt_dashboard_panel_body">
                  <div class="tt_dashboard_chart_legend" t-if="state.activityChart.hasOverdue">
                    <span class="is-due"><i/> Due</span>
                    <span class="is-overdue"><i/> Overdue</span>
                  </div>
                  <div class="tt_dashboard_graph" t-att-class="{ 'is-point-visible': state.activityChart.showPointMarkers }" t-on-mouseleave="onChartPointLeave">
                    <svg viewBox="0 0 640 180" role="img" aria-label="Your activity over time" class="tt_dashboard_graph_svg">
                      <defs>
                        <linearGradient id="wl_dashboard_activity_due_gradient" x1="0" y1="0" x2="0" y2="1">
                          <stop offset="0%" stop-color="var(--wl-erp-primary, #4f6df5)" stop-opacity="0.22"/>
                          <stop offset="100%" stop-color="var(--wl-erp-primary, #4f6df5)" stop-opacity="0.02"/>
                        </linearGradient>
                        <linearGradient id="wl_dashboard_activity_overdue_gradient" x1="0" y1="0" x2="0" y2="1">
                          <stop offset="0%" stop-color="var(--wl-erp-red, #ef596f)" stop-opacity="0.18"/>
                          <stop offset="100%" stop-color="var(--wl-erp-red, #ef596f)" stop-opacity="0.02"/>
                        </linearGradient>
                        <clipPath id="wl_dashboard_activity_plot_clip">
                          <rect
                            t-att-x="state.activityChart.plotLeft"
                            t-att-y="state.activityChart.plotTop"
                            t-att-width="state.activityChart.plotWidth"
                            t-att-height="state.activityChart.plotHeight"
                          />
                        </clipPath>
                      </defs>
                      <g class="tt_dashboard_graph_grid">
                        <line
                          t-foreach="state.activityChart.gridLines"
                          t-as="grid"
                          t-key="grid_index"
                          t-att-x1="state.activityChart.plotLeft"
                          t-att-x2="state.activityChart.plotLeft + state.activityChart.plotWidth"
                          t-att-y1="grid.y"
                          t-att-y2="grid.y"
                        />
                      </g>
                      <g class="tt_dashboard_graph_yaxis">
                        <text
                          t-foreach="state.activityChart.gridLines"
                          t-as="grid"
                          t-key="grid_index"
                          x="34"
                          t-att-y="grid.y"
                          text-anchor="end"
                          dominant-baseline="middle"
                          t-esc="grid.label"
                        />
                      </g>
                      <g clip-path="url(#wl_dashboard_activity_plot_clip)">
                        <path
                          t-if="state.activityChart.overdueAreaPath"
                          class="tt_dashboard_graph_area is-overdue"
                          fill="url(#wl_dashboard_activity_overdue_gradient)"
                          t-att-d="state.activityChart.overdueAreaPath"
                        />
                        <path
                          class="tt_dashboard_graph_area is-due"
                          fill="url(#wl_dashboard_activity_due_gradient)"
                          t-att-d="state.activityChart.dueAreaPath"
                        />
                        <path
                          t-if="state.activityChart.overdueLinePath"
                          class="tt_dashboard_graph_line is-overdue"
                          t-att-d="state.activityChart.overdueLinePath"
                        />
                        <path
                          class="tt_dashboard_graph_line is-due"
                          t-att-d="state.activityChart.dueLinePath"
                        />
                      </g>
                      <g class="tt_dashboard_graph_points is-overdue" t-if="state.activityChart.hasOverdue">
                        <circle
                          t-foreach="state.activityChart.overduePoints"
                          t-as="point"
                          t-key="point_index"
                          t-att-cx="point.x"
                          t-att-cy="point.y"
                          r="3"
                          t-att-class="{ 'is-latest': point_index === state.activityChart.overduePoints.length - 1, 'is-active': state.chartHover &amp;&amp; state.chartHover.index === point.index &amp;&amp; state.chartHover.series === 'overdue' }"
                          t-on-mouseenter="() => this.onChartPointEnter(point, 'overdue')"
                        />
                      </g>
                      <g class="tt_dashboard_graph_points is-due">
                        <circle
                          t-foreach="state.activityChart.duePoints"
                          t-as="point"
                          t-key="point_index"
                          t-att-cx="point.x"
                          t-att-cy="point.y"
                          r="3.25"
                          t-att-class="{ 'is-latest': point_index === state.activityChart.duePoints.length - 1, 'is-active': state.chartHover &amp;&amp; state.chartHover.index === point.index &amp;&amp; state.chartHover.series === 'due' }"
                          t-on-mouseenter="() => this.onChartPointEnter(point, 'due')"
                        />
                      </g>
                      <line
                        class="tt_dashboard_graph_axis"
                        t-att-x1="state.activityChart.plotLeft"
                        t-att-y1="state.activityChart.plotBottom"
                        t-att-x2="state.activityChart.plotLeft + state.activityChart.plotWidth"
                        t-att-y2="state.activityChart.plotBottom"
                      />
                    </svg>
                    <div class="tt_dashboard_graph_labels">
                      <span t-foreach="state.activityChart.labels" t-as="label" t-key="label_index" t-esc="label"/>
                    </div>
                    <div
                      t-if="state.chartHover"
                      class="tt_dashboard_graph_tooltip"
                      t-att-style="chartTooltipStyle()"
                    >
                      <strong t-esc="state.chartHover.label"/>
                      <span t-if="state.chartHover.series === 'due'">
                        <t t-esc="state.chartHover.value"/> due
                      </span>
                      <span t-else="">
                        <t t-esc="state.chartHover.value"/> overdue
                      </span>
                    </div>
                  </div>
                </div>
              </div>
              <aside class="tt_dashboard_panel tt_dashboard_panel_week" t-att-class="{ 'is-empty': !state.weekGlance.length }">
                <div class="tt_dashboard_panel_head">
                  <div>
                    <h3>This week</h3>
                    <p>Due and overdue by day</p>
                  </div>
                </div>
                <div class="tt_dashboard_panel_body">
                  <div class="tt_dashboard_week_legend">
                    <span class="is-due"><i/> Due</span>
                    <span class="is-overdue"><i/> Overdue</span>
                  </div>
                  <ul class="tt_dashboard_week_list">
                    <li t-foreach="state.weekGlance" t-as="day" t-key="day.date" class="tt_dashboard_week_day">
                      <span class="tt_dashboard_week_label" t-esc="day.label"/>
                      <div class="tt_dashboard_week_track">
                        <div class="tt_dashboard_week_fill" t-att-style="weekFillStyle(day)">
                          <span class="tt_dashboard_week_segment is-due" t-att-style="weekDueSegmentStyle(day)" title="Due"/>
                          <span class="tt_dashboard_week_segment is-overdue" t-att-style="weekOverdueSegmentStyle(day)" title="Overdue"/>
                        </div>
                      </div>
                      <span class="tt_dashboard_week_count" t-esc="weekTotalCount(day)"/>
                    </li>
                  </ul>
                </div>
              </aside>
            </section>

            <div class="tt_dashboard_lower_section">

            <!-- D · Attention + Open items by app -->
            <section
              class="tt_dashboard_row tt_dashboard_row_attention"
              t-att-class="{ 'is-single-col': !(state.attentionGroups.length &amp;&amp; state.openByAppChart.length) }"
              t-if="state.attentionGroups.length or state.openByAppChart.length"
            >
              <div class="tt_dashboard_panel tt_dashboard_panel_lower" t-if="state.attentionGroups.length">
                <div class="tt_dashboard_panel_head tt_dashboard_panel_header">
                  <div class="tt_dashboard_panel_title_wrap">
                    <span class="tt_dashboard_panel_icon"><i class="fa fa-exclamation-circle" title="Needs attention"/></span>
                    <div>
                      <h3>Needs attention</h3>
                      <p>Open work queues by app</p>
                    </div>
                  </div>
                  <div class="tt_dashboard_status_chips">
                    <span
                      t-foreach="attentionStatusChips"
                      t-as="chip"
                      t-key="chip.key"
                      class="tt_dashboard_status_chip"
                      t-att-class="'is-' + chip.tone"
                    >
                      <t t-esc="chip.label"/>: <strong t-esc="chip.value"/>
                    </span>
                  </div>
                </div>
                <div class="tt_dashboard_panel_body">
                  <div class="tt_dashboard_attention_groups" t-att-class="{ 'is-multi': state.attentionGroups.length > 1 }">
                    <div
                      t-foreach="state.attentionGroups"
                      t-as="group"
                      t-key="group.app_key"
                      class="tt_dashboard_attention_group"
                    >
                      <h4 t-esc="group.app_name"/>
                      <ul class="tt_dashboard_attention_list">
                        <li
                          t-foreach="group.items"
                          t-as="item"
                          t-key="item.key"
                          t-att-class="{ 'is-urgent': item.urgent }"
                          t-on-click="() => this.openAttentionItem(item)"
                        >
                          <span t-esc="item.label"/>
                          <strong t-esc="item.count"/>
                        </li>
                      </ul>
                    </div>
                  </div>
                </div>
              </div>
              <aside class="tt_dashboard_panel tt_dashboard_panel_lower tt_dashboard_panel_bars" t-if="state.openByAppChart.length">
                <div class="tt_dashboard_panel_head tt_dashboard_panel_header">
                  <div class="tt_dashboard_panel_title_wrap">
                    <span class="tt_dashboard_panel_icon"><i class="fa fa-bar-chart" title="Open items by app"/></span>
                    <div>
                      <h3>Open items by app</h3>
                      <p>What you still need to handle</p>
                    </div>
                  </div>
                </div>
                <div class="tt_dashboard_panel_body">
                  <ul class="tt_dashboard_bar_chart">
                    <li t-foreach="state.openByAppChart" t-as="bar" t-key="bar.app_key">
                      <span class="tt_dashboard_bar_label" t-esc="bar.app_name"/>
                      <div class="tt_dashboard_bar_track">
                        <span class="tt_dashboard_bar_fill" t-att-style="barFillStyle(bar.count)"/>
                      </div>
                      <strong t-esc="bar.count"/>
                    </li>
                  </ul>
                </div>
              </aside>
            </section>

            <!-- E · Work -->
            <section class="tt_dashboard_row tt_dashboard_row_work">
              <div class="tt_dashboard_panel tt_dashboard_panel_lower" t-att-class="{ 'is-empty': !state.activities.length }">
                <div class="tt_dashboard_panel_head tt_dashboard_panel_header">
                  <div class="tt_dashboard_panel_title_wrap">
                    <span class="tt_dashboard_panel_icon"><i class="fa fa-tasks" title="My activities"/></span>
                    <div>
                      <h3>My activities</h3>
                      <p>Next on your list</p>
                    </div>
                  </div>
                  <span class="tt_dashboard_panel_badge" t-esc="state.activities.length"/>
                </div>
                <div class="tt_dashboard_panel_toolbar">
                  <div class="tt_dashboard_filter_tabs">
                    <button type="button" class="tt_dashboard_filter_tab" t-att-class="{ 'is-active': state.activityFilter === 'today' }" t-on-click="() => this.setActivityFilter('today')">Today</button>
                    <button type="button" class="tt_dashboard_filter_tab" t-att-class="{ 'is-active': state.activityFilter === 'overdue' }" t-on-click="() => this.setActivityFilter('overdue')">Overdue</button>
                    <button type="button" class="tt_dashboard_filter_tab" t-att-class="{ 'is-active': state.activityFilter === 'assigned' }" t-on-click="() => this.setActivityFilter('assigned')">Assigned</button>
                  </div>
                </div>
                <div class="tt_dashboard_panel_body">
                  <t t-if="filteredActivities.length">
                    <ul class="tt_dashboard_activity_list">
                      <li
                        t-foreach="filteredActivities"
                        t-as="row"
                        t-key="row.id"
                        class="tt_dashboard_activity_item"
                        t-att-class="{ 'is-overdue': row.overdue }"
                        t-on-click="() => this.openActivityRow(row)"
                      >
                        <span class="tt_dashboard_activity_due" t-esc="formatDueLabel(row.dueDate)"/>
                        <div class="tt_dashboard_activity_main">
                          <strong t-esc="row.summary"/>
                          <span class="tt_dashboard_activity_badge" t-if="row.appLabel" t-esc="row.appLabel"/>
                        </div>
                        <i class="fa fa-chevron-right tt_dashboard_row_chevron"/>
                      </li>
                    </ul>
                  </t>
                  <t t-else="">
                    <div class="tt_dashboard_empty_state">
                      <div class="tt_dashboard_empty_icon"><i class="fa fa-clipboard" title="No activities"/></div>
                      <h4>No activities assigned to you</h4>
                      <p>New tasks and follow-ups will appear here when they are assigned.</p>
                      <ul class="tt_dashboard_skeleton_list" aria-hidden="true">
                        <li/><li/><li/>
                      </ul>
                    </div>
                  </t>
                  <button type="button" class="tt_dashboard_panel_action" t-on-click="openActivities">View all activities</button>
                </div>
              </div>
              <aside class="tt_dashboard_panel tt_dashboard_panel_lower" t-att-class="{ 'is-empty': !state.recentItems.length }">
                <div class="tt_dashboard_panel_head tt_dashboard_panel_header">
                  <div class="tt_dashboard_panel_title_wrap">
                    <span class="tt_dashboard_panel_icon"><i class="fa fa-history" title="Recent items"/></span>
                    <div>
                      <h3>Recent items</h3>
                      <p>Records you updated lately</p>
                    </div>
                  </div>
                  <span class="tt_dashboard_panel_badge" t-esc="state.recentItems.length"/>
                </div>
                <div class="tt_dashboard_panel_body">
                  <t t-if="state.recentItems.length">
                    <ul class="tt_dashboard_recent_list">
                      <li
                        t-foreach="state.recentItems"
                        t-as="item"
                        t-key="item.model + '-' + item.id"
                        class="tt_dashboard_recent_item"
                        t-on-click="() => this.openRecentItem(item)"
                      >
                        <span class="tt_dashboard_recent_icon"><i class="fa fa-file-text-o"/></span>
                        <div class="tt_dashboard_recent_main">
                          <strong t-esc="item.name"/>
                          <span class="tt_dashboard_recent_meta">
                            <span class="tt_dashboard_meta_badge" t-esc="item.appLabel"/>
                            <t t-if="item.writeDateLabel"><t t-esc="item.writeDateLabel"/></t>
                          </span>
                        </div>
                        <i class="fa fa-chevron-right tt_dashboard_row_chevron"/>
                      </li>
                    </ul>
                  </t>
                  <t t-else="">
                    <div class="tt_dashboard_empty_state">
                      <div class="tt_dashboard_empty_icon"><i class="fa fa-folder-open" title="No recent items"/></div>
                      <h4>No recent items yet</h4>
                      <p>Records you open or update will show up in this feed.</p>
                      <ul class="tt_dashboard_skeleton_list" aria-hidden="true">
                        <li/><li/><li/>
                      </ul>
                    </div>
                  </t>
                  <button type="button" class="tt_dashboard_panel_action" t-on-click="openRecentRecords">Open recent records</button>
                </div>
              </aside>
            </section>

            <!-- F · Apps -->
            <section class="tt_dashboard_row tt_dashboard_row_apps">
              <div class="tt_dashboard_panel tt_dashboard_panel_lower tt_dashboard_apps_launcher" t-att-class="{ 'is-empty': !state.apps.length }">
                <div class="tt_dashboard_panel_head tt_dashboard_panel_header">
                  <div class="tt_dashboard_panel_title_wrap">
                    <span class="tt_dashboard_panel_icon"><i class="fa fa-th-large" title="Your apps"/></span>
                    <div>
                      <h3>Your apps</h3>
                      <p>Open an app from here</p>
                    </div>
                  </div>
                  <button type="button" class="tt_dashboard_panel_action tt_dashboard_panel_action_inline" t-on-click="openAllApps">See all apps</button>
                </div>
                <div class="tt_dashboard_panel_body">
                  <t t-if="state.apps.length">
                    <div class="tt_dashboard_app_grid">
                      <button
                        t-foreach="state.apps"
                        t-as="app"
                        t-key="app.menu_id"
                        type="button"
                        class="tt_dashboard_app_tile"
                        t-on-click="() => this.openApp(app)"
                      >
                        <span class="tt_dashboard_app_icon">
                          <img t-if="appIconSrc(app)" t-att-src="appIconSrc(app)" t-att-alt="app.name"/>
                          <span t-else="" class="tt_dashboard_app_initial" t-esc="appInitial(app)"/>
                        </span>
                        <span class="tt_dashboard_app_content">
                          <span class="tt_dashboard_app_name" t-esc="app.name"/>
                          <span class="tt_dashboard_app_category" t-esc="appCategory(app)"/>
                          <span class="tt_dashboard_app_meta" t-if="app.open_count || app.overdue_count">
                            <t t-if="app.open_count"><t t-esc="app.open_count"/> open</t>
                            <t t-if="app.open_count &amp;&amp; app.overdue_count"> · </t>
                            <t t-if="app.overdue_count"><t t-esc="app.overdue_count"/> overdue</t>
                          </span>
                        </span>
                        <i class="fa fa-arrow-right tt_dashboard_app_arrow"/>
                      </button>
                    </div>
                  </t>
                  <t t-else="">
                    <div class="tt_dashboard_empty_state">
                      <div class="tt_dashboard_empty_icon"><i class="fa fa-th" title="No apps"/></div>
                      <h4>No apps available</h4>
                      <p>Ask your administrator for access to start working from here.</p>
                    </div>
                  </t>
                </div>
              </div>
              <aside class="tt_dashboard_panel tt_dashboard_panel_lower tt_dashboard_upcoming_card" t-att-class="{ 'is-empty': !state.upcoming.length }">
                <div class="tt_dashboard_panel_head tt_dashboard_panel_header">
                  <div class="tt_dashboard_panel_title_wrap">
                    <span class="tt_dashboard_panel_icon"><i class="fa fa-calendar" title="Upcoming"/></span>
                    <div>
                      <h3>Upcoming</h3>
                      <p>Meetings and deadlines</p>
                    </div>
                  </div>
                </div>
                <div class="tt_dashboard_panel_toolbar">
                  <div class="tt_dashboard_filter_chips">
                    <button type="button" class="tt_dashboard_filter_chip" t-att-class="{ 'is-active': state.upcomingFilter === 'today' }" t-on-click="() => this.setUpcomingFilter('today')">Today</button>
                    <button type="button" class="tt_dashboard_filter_chip" t-att-class="{ 'is-active': state.upcomingFilter === 'week' }" t-on-click="() => this.setUpcomingFilter('week')">This week</button>
                    <button type="button" class="tt_dashboard_filter_chip" t-att-class="{ 'is-active': state.upcomingFilter === 'deadlines' }" t-on-click="() => this.setUpcomingFilter('deadlines')">Deadlines</button>
                  </div>
                </div>
                <div class="tt_dashboard_panel_body">
                  <t t-if="filteredUpcoming.length">
                    <ul class="tt_dashboard_upcoming_list">
                      <li
                        t-foreach="filteredUpcoming"
                        t-as="item"
                        t-key="item.key"
                        class="tt_dashboard_upcoming_item"
                        t-on-click="() => this.openUpcomingItem(item)"
                      >
                        <span class="tt_dashboard_upcoming_icon"><i class="fa fa-calendar"/></span>
                        <div class="tt_dashboard_upcoming_main">
                          <strong t-esc="item.label"/>
                          <span t-esc="item.datetimeLabel"/>
                        </div>
                        <i class="fa fa-chevron-right tt_dashboard_row_chevron"/>
                      </li>
                    </ul>
                  </t>
                  <t t-else="">
                    <div class="tt_dashboard_empty_state tt_dashboard_empty_state_compact">
                      <div class="tt_dashboard_empty_icon"><i class="fa fa-calendar-o" title="No upcoming events"/></div>
                      <h4>No upcoming events</h4>
                      <p>Meetings and deadlines will appear here.</p>
                    </div>
                  </t>
                  <button type="button" class="tt_dashboard_panel_action" t-on-click="openCalendar">Open calendar</button>
                </div>
              </aside>
            </section>

            <!-- G · Summary -->
            <section class="tt_dashboard_summary_bar">
              <div class="tt_dashboard_panel tt_dashboard_panel_compact tt_dashboard_summary_overview">
                <div class="tt_dashboard_summary_items">
                  <div
                    t-foreach="summaryOverviewItems"
                    t-as="item"
                    t-key="item.key"
                    class="tt_dashboard_summary_item"
                    t-att-class="`is-${item.tone}`"
                  >
                    <span class="tt_dashboard_summary_item_icon"><i t-att-class="`fa ${item.icon}`"/></span>
                    <div>
                      <span class="tt_dashboard_summary_item_label" t-esc="item.label"/>
                      <strong class="tt_dashboard_summary_item_value" t-esc="item.value"/>
                    </div>
                  </div>
                </div>
                <div class="tt_dashboard_quick_col" t-if="state.quickLinks.length">
                  <ul class="tt_dashboard_quick_links tt_dashboard_quick_links_pills">
                    <li t-foreach="state.quickLinks" t-as="link" t-key="link.key">
                      <button type="button" class="tt_dashboard_quick_link" t-on-click="() => this.openQuickLink(link)" t-esc="link.label"/>
                    </li>
                  </ul>
                </div>
              </div>
            </section>

            </div>

          </div>
        </main>

        <!-- H · Footer -->
        <footer class="wl_sp_dashboard_footer wl_sp_footer_card" id="wl_sp_dashboard_footer">
          <div class="wl_sp_footer_inner">
            <div class="wl_sp_footer_row wl_sp_footer_row_primary">
              <div class="wl_sp_footer_group wl_sp_footer_group_env">
                <span id="wl_sp_footer_env_badge" class="wl_sp_footer_env_badge is-production" hidden="hidden"/>
                <span class="wl_sp_footer_env_sep" aria-hidden="true">·</span>
                <span id="wl_sp_footer_company_db" class="wl_sp_footer_company_db"/>
              </div>
              <div class="wl_sp_footer_group wl_sp_footer_group_user">
                <span id="wl_sp_footer_user_role"/>
                <span class="wl_sp_footer_sep">·</span>
                <span id="wl_sp_footer_locale"/>
              </div>
              <div class="wl_sp_footer_group wl_sp_footer_group_meta">
                <span class="wl_sp_footer_refresh_label">Updated</span>
                <button type="button" class="wl_sp_footer_refresh_btn" data-wl-action="refresh-dashboard-data" id="wl_sp_footer_last_refresh"/>
                <span class="wl_sp_footer_sep">·</span>
                <span id="wl_sp_footer_support_row" hidden="hidden">Support: <span id="wl_sp_footer_support"/></span>
                <span id="wl_sp_footer_support_sep" class="wl_sp_footer_sep">·</span>
                <span id="wl_sp_footer_build_row" hidden="hidden">Build: <span id="wl_sp_footer_build_version"/></span>
                <span id="wl_sp_footer_build_sep" class="wl_sp_footer_sep">·</span>
                <span>Odoo <span id="wl_sp_footer_odoo_version"/></span>
                <span class="wl_sp_footer_sep">·</span>
                <span>Willow <span id="wl_sp_footer_theme_version"/></span>
                <span class="wl_sp_footer_sep">·</span>
                <span id="wl_sp_footer_shortcut" class="wl_sp_footer_shortcut"/>
              </div>
            </div>
            <div class="wl_sp_footer_row wl_sp_footer_row_secondary">
              <div id="wl_sp_footer_actions" class="wl_sp_footer_actions">
                <button type="button" class="wl_sp_footer_action" data-wl-action="open-settings" hidden="hidden">Settings</button>
                <button type="button" class="wl_sp_footer_action" data-wl-action="open-users" hidden="hidden">Users</button>
                <button type="button" class="wl_sp_footer_action" data-wl-action="open-scheduled-actions" hidden="hidden">Scheduled actions</button>
                <button type="button" class="wl_sp_footer_action" data-wl-action="toggle-debug" id="wl_sp_footer_debug_link" hidden="hidden">Developer mode</button>
              </div>
              <div id="wl_sp_footer_status_section" class="wl_sp_footer_status" hidden="hidden">
                <span>Jobs: <strong id="wl_sp_footer_jobs"/></span>
                <span class="wl_sp_footer_sep">·</span>
                <span>Mail queue: <strong id="wl_sp_footer_mail_queue"/></span>
                <span class="wl_sp_footer_sep">·</span>
                <span>Integrations: <strong id="wl_sp_footer_integrations"/></span>
              </div>
            </div>
          </div>
          <span id="wl_sp_footer_period" hidden="hidden"/>
          <span id="wl_sp_footer_scope" hidden="hidden"/>
          <span id="wl_sp_footer_filters" hidden="hidden"/>
        </footer>

      </div>
    </div>
  </t>

</templates>
